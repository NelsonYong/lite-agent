{
  "templateVersion": "1.0",
  "templateName": "症状评估模板 (Symptom Assessment Template)",
  "description": "用于系统化收集和评估患者症状信息的标准化模板",
  "sections": [
    {
      "section": "基本信息 (Basic Information)",
      "fields": {
        "patientAge": {
          "type": "number",
          "label": "年龄",
          "required": true,
          "unit": "岁"
        },
        "patientGender": {
          "type": "select",
          "label": "性别",
          "required": true,
          "options": ["男", "女"]
        },
        "chiefComplaint": {
          "type": "text",
          "label": "主诉症状",
          "required": true,
          "description": "患者最主要的不适症状"
        }
      }
    },
    {
      "section": "OPQRST 症状分析框架",
      "fields": {
        "onset": {
          "type": "object",
          "label": "O - Onset (发作)",
          "subfields": {
            "startTime": {
              "type": "datetime",
              "label": "症状开始时间"
            },
            "suddenOrGradual": {
              "type": "select",
              "label": "发作方式",
              "options": ["突然发作", "逐渐出现"]
            },
            "firstTimeOrRecurrent": {
              "type": "select",
              "label": "发作频率",
              "options": ["首次发生", "反复发作"]
            },
            "frequency": {
              "type": "text",
              "label": "发作频率",
              "description": "如：每天3-4次，每周1-2次"
            }
          }
        },
        "provocationPalliation": {
          "type": "object",
          "label": "P - Provocation/Palliation (诱发/缓解因素)",
          "subfields": {
            "aggravatingFactors": {
              "type": "array",
              "label": "加重因素",
              "examples": ["进食", "运动", "平躺", "压力"]
            },
            "relievingFactors": {
              "type": "array",
              "label": "缓解因素",
              "examples": ["休息", "用药", "改变体位"]
            }
          }
        },
        "quality": {
          "type": "object",
          "label": "Q - Quality (性质)",
          "subfields": {
            "description": {
              "type": "text",
              "label": "症状描述",
              "examples": ["刺痛", "胀痛", "绞痛", "烧灼感", "压迫感"]
            },
            "characteristics": {
              "type": "array",
              "label": "特征",
              "examples": ["持续性", "间歇性", "搏动性"]
            }
          }
        },
        "region": {
          "type": "object",
          "label": "R - Region/Radiation (部位/放射)",
          "subfields": {
            "location": {
              "type": "text",
              "label": "具体部位",
              "description": "精确描述症状位置"
            },
            "radiation": {
              "type": "boolean",
              "label": "是否向其他部位扩散"
            },
            "radiationSites": {
              "type": "array",
              "label": "放射部位",
              "conditional": "radiation === true"
            }
          }
        },
        "severity": {
          "type": "object",
          "label": "S - Severity (严重程度)",
          "subfields": {
            "painScale": {
              "type": "number",
              "label": "疼痛评分",
              "min": 0,
              "max": 10,
              "description": "0=无痛, 10=剧痛"
            },
            "impactOnDailyLife": {
              "type": "select",
              "label": "对日常生活的影响",
              "options": ["无影响", "轻度影响", "中度影响", "严重影响", "完全无法活动"]
            },
            "sleepDisturbance": {
              "type": "boolean",
              "label": "是否影响睡眠"
            }
          }
        },
        "time": {
          "type": "object",
          "label": "T - Time (时间)",
          "subfields": {
            "duration": {
              "type": "text",
              "label": "持续时间",
              "examples": ["数分钟", "数小时", "数天", "数周"]
            },
            "pattern": {
              "type": "text",
              "label": "发作规律",
              "examples": ["晨起加重", "夜间明显", "餐后出现"]
            }
          }
        }
      }
    },
    {
      "section": "伴随症状 (Associated Symptoms)",
      "fields": {
        "associatedSymptoms": {
          "type": "array",
          "label": "伴随症状",
          "options": [
            "发热",
            "寒战",
            "恶心",
            "呕吐",
            "腹泻",
            "便秘",
            "头晕",
            "头痛",
            "乏力",
            "体重变化",
            "食欲改变",
            "咳嗽",
            "呼吸困难",
            "心悸",
            "出汗"
          ]
        }
      }
    },
    {
      "section": "红旗症状筛查 (Red Flags Screening)",
      "fields": {
        "redFlagSymptoms": {
          "type": "checklist",
          "label": "危险信号",
          "critical": true,
          "options": [
            {
              "symptom": "剧烈胸痛",
              "system": "心血管",
              "urgency": "立即就医"
            },
            {
              "symptom": "呼吸困难",
              "system": "呼吸系统",
              "urgency": "立即就医"
            },
            {
              "symptom": "突发剧烈头痛",
              "system": "神经系统",
              "urgency": "立即就医"
            },
            {
              "symptom": "肢体无力或麻木",
              "system": "神经系统",
              "urgency": "立即就医"
            },
            {
              "symptom": "言语不清",
              "system": "神经系统",
              "urgency": "立即就医"
            },
            {
              "symptom": "呕血或黑便",
              "system": "消化系统",
              "urgency": "立即就医"
            },
            {
              "symptom": "意识改变",
              "system": "神经系统",
              "urgency": "立即就医"
            },
            {
              "symptom": "高热不退(>39°C)",
              "system": "全身",
              "urgency": "尽快就医"
            }
          ]
        }
      }
    },
    {
      "section": "既往史 (Medical History)",
      "fields": {
        "pastMedicalHistory": {
          "type": "array",
          "label": "既往疾病",
          "examples": ["高血压", "糖尿病", "心脏病", "哮喘", "肝病", "肾病"]
        },
        "surgicalHistory": {
          "type": "array",
          "label": "手术史"
        },
        "allergies": {
          "type": "array",
          "label": "药物过敏史",
          "critical": true
        },
        "currentMedications": {
          "type": "array",
          "label": "当前用药",
          "items": {
            "type": "object",
            "fields": {
              "medicationName": "药品名称",
              "dosage": "剂量",
              "frequency": "频率"
            }
          }
        },
        "familyHistory": {
          "type": "array",
          "label": "家族史",
          "examples": ["心脏病", "糖尿病", "高血压", "癌症"]
        }
      }
    },
    {
      "section": "生活方式 (Lifestyle)",
      "fields": {
        "smoking": {
          "type": "object",
          "label": "吸烟史",
          "subfields": {
            "status": {
              "type": "select",
              "options": ["从不吸烟", "已戒烟", "目前吸烟"]
            },
            "packsPerDay": {
              "type": "number",
              "label": "每日吸烟量（包）",
              "conditional": "status === '目前吸烟'"
            },
            "years": {
              "type": "number",
              "label": "吸烟年数"
            }
          }
        },
        "alcohol": {
          "type": "object",
          "label": "饮酒史",
          "subfields": {
            "frequency": {
              "type": "select",
              "options": ["从不饮酒", "偶尔", "经常", "每天"]
            },
            "amount": {
              "type": "text",
              "label": "饮酒量"
            }
          }
        },
        "exercise": {
          "type": "object",
          "label": "运动习惯",
          "subfields": {
            "frequency": {
              "type": "select",
              "options": ["很少运动", "每周1-2次", "每周3-5次", "每天"]
            },
            "duration": {
              "type": "text",
              "label": "每次运动时长"
            }
          }
        }
      }
    },
    {
      "section": "初步评估 (Preliminary Assessment)",
      "fields": {
        "differentialDiagnosis": {
          "type": "array",
          "label": "鉴别诊断列表",
          "description": "根据症状列出可能的诊断",
          "items": {
            "type": "object",
            "fields": {
              "diagnosis": "诊断名称",
              "probability": {
                "type": "select",
                "options": ["高", "中", "低"]
              },
              "reasoning": "诊断依据"
            }
          }
        },
        "urgencyLevel": {
          "type": "select",
          "label": "紧急程度",
          "options": [
            "立即就医（急诊）",
            "24小时内就医",
            "1周内就医",
            "常规随访",
            "可居家观察"
          ]
        },
        "recommendedTests": {
          "type": "array",
          "label": "建议检查项目",
          "examples": ["血常规", "尿常规", "心电图", "胸部X线", "腹部超声", "CT/MRI"]
        },
        "recommendedSpecialty": {
          "type": "select",
          "label": "建议就诊科室",
          "options": [
            "急诊科",
            "心内科",
            "呼吸内科",
            "消化内科",
            "神经内科",
            "内分泌科",
            "普通外科",
            "骨科",
            "泌尿外科",
            "妇产科",
            "耳鼻喉科",
            "全科/家庭医生"
          ]
        }
      }
    },
    {
      "section": "随访计划 (Follow-up Plan)",
      "fields": {
        "selfCareInstructions": {
          "type": "array",
          "label": "居家护理指导"
        },
        "warningSignsToReturn": {
          "type": "array",
          "label": "需要返院的警示症状"
        },
        "followUpTiming": {
          "type": "text",
          "label": "随访时间建议"
        }
      }
    }
  ],
  "usage": {
    "description": "本模板用于系统化收集患者症状信息，支持临床决策",
    "instructions": [
      "按照各节内容顺序收集信息",
      "重点关注红旗症状筛查",
      "OPQRST框架确保症状描述完整",
      "根据评估结果给出合理建议",
      "记录评估时间和评估者信息"
    ]
  },
  "metadata": {
    "version": "1.0",
    "lastUpdated": "2026-01-13",
    "author": "AGUI Medical Team",
    "references": [
      "Clinical Assessment Guidelines",
      "OPQRST Symptom Analysis Framework",
      "Emergency Medicine Triage Protocols"
    ]
  }
}
